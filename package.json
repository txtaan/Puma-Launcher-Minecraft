{
  "name": "txtaan-launcher",
  "productName": "Txtaan Launcher",
  "version": "0.1.0",
  "description": "A modern open-source Minecraft launcher inspired by HMCL and Prism Launcher",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "dev.txtaan.launcher",
    "productName": "Txtaan Launcher",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
